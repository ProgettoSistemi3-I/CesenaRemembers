
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNotBanned() {
      return isSignedIn() &&
        !exists(/databases/$(database)/documents/banned_users/$(request.auth.uid));
    }

    function isValidUsernameId(value) {
      return value is string && value.matches('^[a-z0-9_.]{3,20}$');
    }

    function validPreferences(prefs) {
      return prefs is map &&
        prefs.keys().hasOnly([
          'notifiche', 'modalitaNotte', 'posizioneGps', 'languageCode'
        ]) &&
        (!('notifiche' in prefs) || prefs.notifiche is bool) &&
        (!('modalitaNotte' in prefs) || prefs.modalitaNotte is bool) &&
        (!('posizioneGps' in prefs) || prefs.posizioneGps is bool) &&
        (!('languageCode' in prefs) ||
          (prefs.languageCode is string &&
           prefs.languageCode in ['it', 'en']));
    }

    function validVisitedPoiIds(ids) {
      return ids is list &&
        ids.size() <= 10 &&
        ids.toSet().size() == ids.size() &&
        ids.hasOnly([
          'santa_cristina', 'rocca', 'san_rocco', 'abbazia_monte',
          'osservanza', 'palazzo_ridotto', 'stazione', 'arrigoni',
          'fantaguzzi', 'rifugi_antiaerei'
        ]);
    }

    function validAchievementList(ids) {
      return ids is list &&
        ids.size() <= 10 &&
        ids.toSet().size() == ids.size() &&
        ids.hasOnly([
          'first_visit', 'first_quiz', 'first_tour', 'quiz_15',
          'perfect_tour', 'xp_500', 'tour_under_1h', 'tour_under_30m',
          'friend_1', 'friend_5'
        ]);
    }

    // ---------------------------------------------------------
    // PUBLIC PROFILES
    // ---------------------------------------------------------

    function validPublicProfileShape(data) {
      return data.keys().hasOnly([
          'displayName', 'displayNameNormalized', 'username',
          'usernameNormalized', 'avatarId', 'profileCompleted',
          'onboardingCompleted', 'xp', 'friendsCount',
          'totalToursCompleted'
        ]) &&
        data.get('displayName', null) is string &&
        data.displayName.size() >= 2 &&
        data.displayName.size() <= 30 &&
        data.get('displayNameNormalized', null) is string &&
        data.displayNameNormalized.size() <= 30 &&
        data.displayNameNormalized == data.displayName.lower() &&
        data.get('username', null) is string &&
        isValidUsernameId(data.username.lower()) &&
        data.get('usernameNormalized', null) is string &&
        isValidUsernameId(data.usernameNormalized) &&
        data.usernameNormalized == data.username.lower() &&
        data.get('avatarId', null) is string &&
        data.avatarId.size() > 0 &&
        data.avatarId.size() <= 40 &&
        data.get('profileCompleted', false) == true &&
        data.get('onboardingCompleted', false) is bool &&
        data.get('xp', 0) is int &&
        data.xp >= 0 &&
        data.xp <= 1000000000 &&
        data.get('friendsCount', 0) is int &&
        data.friendsCount >= 0 &&
        data.friendsCount <= 500 &&
        data.get('totalToursCompleted', 0) is int &&
        data.totalToursCompleted >= 0;
    }

    function publicProfileFieldsMatch(privateData, publicData) {
      return publicData.displayName == privateData.displayName &&
        publicData.displayNameNormalized == privateData.displayNameNormalized &&
        publicData.username == privateData.username &&
        publicData.usernameNormalized == privateData.usernameNormalized &&
        publicData.avatarId == privateData.avatarId &&
        publicData.profileCompleted == privateData.profileCompleted &&
        publicData.onboardingCompleted ==
          privateData.get('onboardingCompleted', false) &&
        publicData.get('xp', 0) == privateData.get('xp', 0) &&
        publicData.get('friendsCount', 0) ==
          privateData.get('friends', []).size() &&
        publicData.get('totalToursCompleted', 0) ==
          privateData.get('totalToursCompleted', 0);
    }

    function publicMirrorMatches(uid) {
      let privateData =
        getAfter(/databases/$(database)/documents/users/$(uid)).data;

      let publicData =
        getAfter(/databases/$(database)/documents/public_profiles/$(uid)).data;

      return publicProfileFieldsMatch(privateData, publicData);
    }

    function validPublicProfileCreate(uid) {
      let userAfter =
        getAfter(/databases/$(database)/documents/users/$(uid)).data;

      return userAfter.get('profileCompleted', false) == true &&
        validPublicProfileShape(request.resource.data) &&
        publicProfileFieldsMatch(userAfter, request.resource.data);
    }

    function validCrossPublicProfileFriendsCountUpdate(uid) {
      let targetPath =
        /databases/$(database)/documents/users/$(uid);

      let callerPath =
        /databases/$(database)/documents/users/$(request.auth.uid);

      let targetBefore = get(targetPath).data;
      let targetAfter = getAfter(targetPath).data;
      let callerBefore = get(callerPath).data;
      let callerAfter = getAfter(callerPath).data;

      let oldFriends = targetBefore.get('friends', []);
      let newFriends = targetAfter.get('friends', []);

      let addedReciprocalFriend =
        listAddsOnly(oldFriends, newFriends, request.auth.uid) &&
        !callerBefore.get('friends', []).hasAny([uid]) &&
        callerAfter.get('friends', []).hasAny([uid]);

      let removedReciprocalFriend =
        listRemovesOnly(oldFriends, newFriends, request.auth.uid) &&
        callerBefore.get('friends', []).hasAny([uid]) &&
        !callerAfter.get('friends', []).hasAny([uid]);

      return isNotBanned() &&
        uid != request.auth.uid &&
        !exists(/databases/$(database)/documents/banned_users/$(uid)) &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['friendsCount']) &&
        validPublicProfileShape(request.resource.data) &&
        publicProfileFieldsMatch(targetAfter, request.resource.data) &&
        request.resource.data.friendsCount == newFriends.size() &&
        (addedReciprocalFriend || removedReciprocalFriend);
    }

    // ---------------------------------------------------------
    // FRIEND STATS
    // ---------------------------------------------------------

    function validFriendStatsShape(data) {
      return data.keys().hasOnly([
          'xp', 'visitedPoiIds', 'unlockedAchievements', 'maxQuizScore',
          'totalQuizCompleted', 'totalToursCompleted', 'totalCorrectAnswers',
          'bestTourTimeSeconds', 'maxSingleTourXp', 'friends'
        ]) &&
        data.get('xp', 0) is int &&
        data.xp >= 0 &&
        data.xp <= 1000000000 &&
        validVisitedPoiIds(data.get('visitedPoiIds', [])) &&
        validAchievementList(data.get('unlockedAchievements', [])) &&
        data.get('maxQuizScore', 0) is int &&
        data.maxQuizScore >= 0 &&
        data.maxQuizScore <= 100 &&
        data.get('totalQuizCompleted', 0) is int &&
        data.totalQuizCompleted >= 0 &&
        data.get('totalToursCompleted', 0) is int &&
        data.totalToursCompleted >= 0 &&
        data.get('totalCorrectAnswers', 0) is int &&
        data.totalCorrectAnswers >= 0 &&
        data.get('bestTourTimeSeconds', 0) is int &&
        data.bestTourTimeSeconds >= 0 &&
        data.get('maxSingleTourXp', 0) is int &&
        data.maxSingleTourXp >= 0 &&
        data.get('friends', []) is list &&
        data.friends.size() <= 500;
    }

    // Non confronta friends: la sincronizzazione della lista viene gestita
    // dalle regole dedicate alle operazioni sociali.
    function friendStatsFieldsMatch(privateData, statsData) {
      return statsData.get('xp', 0) == privateData.get('xp', 0) &&
        statsData.get('visitedPoiIds', []) ==
          privateData.get('visitedPoiIds', []) &&
        statsData.get('unlockedAchievements', []) ==
          privateData.get('unlockedAchievements', []) &&
        statsData.get('maxQuizScore', 0) ==
          privateData.get('maxQuizScore', 0) &&
        statsData.get('totalQuizCompleted', 0) ==
          privateData.get('totalQuizCompleted', 0) &&
        statsData.get('totalToursCompleted', 0) ==
          privateData.get('totalToursCompleted', 0) &&
        statsData.get('totalCorrectAnswers', 0) ==
          privateData.get('totalCorrectAnswers', 0) &&
        statsData.get('bestTourTimeSeconds', 0) ==
          privateData.get('bestTourTimeSeconds', 0) &&
        statsData.get('maxSingleTourXp', 0) ==
          privateData.get('maxSingleTourXp', 0);
    }

    function friendStatsMirrorMatches(uid) {
      let privateData =
        getAfter(/databases/$(database)/documents/users/$(uid)).data;

      let statsData =
        getAfter(/databases/$(database)/documents/friend_stats/$(uid)).data;

      return friendStatsFieldsMatch(privateData, statsData);
    }

    function validFriendStatsCreate(uid) {
      let userAfter =
        getAfter(/databases/$(database)/documents/users/$(uid)).data;

      return userAfter.get('profileCompleted', false) == true &&
        validFriendStatsShape(request.resource.data) &&
        friendStatsFieldsMatch(userAfter, request.resource.data) &&
        request.resource.data.get('friends', []) ==
          userAfter.get('friends', []);
    }

    function areFriends(uid) {
      let callerPath =
        /databases/$(database)/documents/users/$(request.auth.uid);

      let targetPath =
        /databases/$(database)/documents/users/$(uid);

      return isSignedIn() &&
        exists(callerPath) &&
        exists(targetPath) &&
        get(callerPath).data.get('friends', []).hasAny([uid]) &&
        get(targetPath).data.get('friends', []).hasAny([request.auth.uid]);
    }

    function hasBlockBetween(uidA, uidB) {
      return exists(
        /databases/$(database)/documents/user_blocks/$(uidA)/blocked/$(uidB)
      ) || exists(
        /databases/$(database)/documents/user_blocks/$(uidB)/blocked/$(uidA)
      );
    }

    function canReadFriendStats(uid) {
      return isNotBanned() &&
        !exists(/databases/$(database)/documents/banned_users/$(uid)) &&
        (
          isOwner(uid) ||
          (!hasBlockBetween(request.auth.uid, uid) && areFriends(uid))
        );
    }

    // Aggiornamento della lista amici da parte di un altro utente.
    function validCrossFriendStatsUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      let targetAfter =
        getAfter(/databases/$(database)/documents/users/$(uid)).data;

      let callerAfter =
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;

      let oldFriends = resource.data.get('friends', []);
      let newFriends = request.resource.data.get('friends', []);

      return changed.hasOnly(['friends']) &&
        request.resource.data.keys().hasOnly([
          'xp', 'visitedPoiIds', 'unlockedAchievements', 'maxQuizScore',
          'totalQuizCompleted', 'totalToursCompleted', 'totalCorrectAnswers',
          'bestTourTimeSeconds', 'maxSingleTourXp', 'friends'
        ]) &&
        newFriends is list &&
        newFriends.size() <= 500 &&
        newFriends == targetAfter.get('friends', []) &&
        (
          (
            listAddsOnly(oldFriends, newFriends, request.auth.uid) &&
            callerAfter.get('friends', []).hasAny([uid])
          ) ||
          (
            listRemovesOnly(oldFriends, newFriends, request.auth.uid) &&
            !callerAfter.get('friends', []).hasAny([uid])
          )
        );
    }

    // Aggiornamento della lista amici da parte del proprietario.
    function validOwnerFriendStatsFriendsUpdate(uid) {
      let userAfter =
        getAfter(/databases/$(database)/documents/users/$(uid)).data;

      let peer = userAfter.get('lastFriendActionPeerUid', '');

      let oldFriends = resource.data.get('friends', []);
      let newFriends = request.resource.data.get('friends', []);

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['friends']) &&
        validFriendStatsShape(request.resource.data) &&
        peer is string &&
        peer.size() > 0 &&
        peer != uid &&
        newFriends is list &&
        newFriends.size() <= 500 &&
        newFriends == userAfter.get('friends', []) &&
        (
          listAddsOnly(oldFriends, newFriends, peer) ||
          listRemovesOnly(oldFriends, newFriends, peer)
        );
    }

    // ---------------------------------------------------------
    // LIST OPERATIONS
    // ---------------------------------------------------------

    function listAddsOne(oldList, newList) {
      return oldList is list &&
        newList is list &&
        newList.size() == oldList.size() + 1 &&
        newList.hasAll(oldList);
    }

    function listRemovesOne(oldList, newList) {
      return oldList is list &&
        newList is list &&
        oldList.size() == newList.size() + 1 &&
        oldList.hasAll(newList);
    }

    function listAddsOnly(oldList, newList, item) {
      return !oldList.hasAny([item]) &&
        newList.hasAny([item]) &&
        listAddsOne(oldList, newList);
    }

    function listRemovesOnly(oldList, newList, item) {
      return oldList.hasAny([item]) &&
        !newList.hasAny([item]) &&
        listRemovesOne(oldList, newList);
    }

    // ---------------------------------------------------------
    // ACHIEVEMENTS
    // ---------------------------------------------------------

    function validAchievementIdsAdded(oldData, newData, oldList, newList) {
      let added = newList.toSet().difference(oldList.toSet());

      let completedTourNow =
        newData.get('totalToursCompleted', 0) >
        oldData.get('totalToursCompleted', 0);

      return newList is list &&
        oldList is list &&
        newList.size() <= 10 &&
        newList.hasAll(oldList) &&
        newList.size() <= oldList.size() + 10 &&
        added.hasOnly([
          'first_visit', 'first_quiz', 'first_tour', 'quiz_15',
          'perfect_tour', 'xp_500', 'tour_under_1h', 'tour_under_30m'
        ]) &&
        (
          !added.hasAny(['first_visit']) ||
          newData.get('visitedPoiIds', []).size() > 0
        ) &&
        (
          !added.hasAny(['first_quiz']) ||
          newData.get('totalQuizCompleted', 0) >= 1
        ) &&
        (
          !added.hasAny(['first_tour']) ||
          newData.get('totalToursCompleted', 0) >= 1
        ) &&
        (
          !added.hasAny(['quiz_15']) ||
          newData.get('totalQuizCompleted', 0) >= 15
        ) &&
        (
          !added.hasAny(['perfect_tour']) ||
          (
            completedTourNow &&
            newData.get('totalCorrectAnswers', 0) >
              oldData.get('totalCorrectAnswers', 0)
          )
        ) &&
        (
          !added.hasAny(['xp_500']) ||
          newData.get('xp', 0) >= 500
        ) &&
        (
          !added.hasAny(['tour_under_1h']) ||
          (
            completedTourNow &&
            newData.get('bestTourTimeSeconds', 0) >= 300 &&
            newData.get('bestTourTimeSeconds', 0) < 3600
          )
        ) &&
        (
          !added.hasAny(['tour_under_30m']) ||
          (
            completedTourNow &&
            newData.get('bestTourTimeSeconds', 0) >= 300 &&
            newData.get('bestTourTimeSeconds', 0) < 1800
          )
        );
    }

    function validOwnerFriendAchievementUpdate() {
      let old = resource.data;
      let next = request.resource.data;

      let oldPending = old.get('pendingAchievements', []);
      let newPending = next.get('pendingAchievements', []);

      let added = newPending.toSet().difference(oldPending.toSet());

      let friendCount = old.get('friends', []).size();

      return next.diff(old).affectedKeys().hasOnly([
          'pendingAchievements', 'updatedAt'
        ]) &&
        next.get('updatedAt', null) == request.time &&
        validAchievementList(newPending) &&
        newPending.hasAll(oldPending) &&
        added.hasOnly(['friend_1', 'friend_5']) &&
        (
          !added.hasAny(['friend_1']) ||
          (
            friendCount >= 1 &&
            !old.get('unlockedAchievements', []).hasAny(['friend_1'])
          )
        ) &&
        (
          !added.hasAny(['friend_5']) ||
          (
            friendCount >= 5 &&
            !old.get('unlockedAchievements', []).hasAny(['friend_5'])
          )
        );
    }

    function friendAchievementChangeAllowed(oldList, newList) {
      return newList is list &&
        oldList is list &&
        newList.hasAll(oldList) &&
        newList.size() <= oldList.size() + 2 &&
        newList.toSet().difference(oldList.toSet())
          .hasOnly(['friend_1', 'friend_5']);
    }

    // ---------------------------------------------------------
    // LEADERBOARD
    // ---------------------------------------------------------

    function validLeaderboardProjection(uid, data) {
      let userAfter =
        getAfter(/databases/$(database)/documents/users/$(uid)).data;

      return data.keys().hasOnly(['uid', 'xp']) &&
        data.get('uid', '') == uid &&
        data.get('xp', -1) is int &&
        data.xp >= 0 &&
        userAfter.get('profileCompleted', false) == true &&
        data.xp == userAfter.get('xp', 0);
    }

    function leaderboardMirrorMatches(uid) {
      let leaderboardData =
        getAfter(/databases/$(database)/documents/leaderboard/$(uid)).data;

      let userAfter =
        getAfter(/databases/$(database)/documents/users/$(uid)).data;

      return leaderboardData.get('uid', '') == uid &&
        leaderboardData.get('xp', -1) == userAfter.get('xp', 0);
    }

    // ---------------------------------------------------------
    // INITIAL PROFILE
    // ---------------------------------------------------------

    function validInitialProfileData(uid, d) {
      let usernamePath =
        /databases/$(database)/documents/usernames/$(d.usernameNormalized);

      let publicPath =
        /databases/$(database)/documents/public_profiles/$(uid);

      let statsPath =
        /databases/$(database)/documents/friend_stats/$(uid);

      return d.get('profileCompleted', false) == true &&
        d.email is string &&
        d.email.size() <= 254 &&
        request.auth.token.email == d.email &&
        (!('createdAt' in d) || d.createdAt is timestamp) &&
        d.displayName is string &&
        d.displayName.size() >= 2 &&
        d.displayName.size() <= 30 &&
        d.displayNameNormalized == d.displayName.lower() &&
        isValidUsernameId(d.usernameNormalized) &&
        d.username == d.usernameNormalized &&
        d.avatarId is string &&
        d.avatarId.size() > 0 &&
        d.avatarId.size() <= 40 &&
        d.onboardingCompleted is bool &&
        d.profileCompletedAt is timestamp &&
        d.xp == 0 &&
        d.leaderboardScore == 0 &&
        d.maxQuizScore == 0 &&
        d.totalQuizCompleted == 0 &&
        d.totalToursCompleted == 0 &&
        d.totalCorrectAnswers == 0 &&
        d.bestTourTimeSeconds == 0 &&
        d.maxSingleTourXp == 0 &&
        d.visitedPoiIds == [] &&
        d.unlockedAchievements == [] &&
        d.pendingAchievements == [] &&
        d.friends == [] &&
        d.sentFriendRequests == [] &&
        d.receivedFriendRequests == [] &&
        d.fcmTokens is list &&
        d.fcmTokens.size() <= 20 &&
        validPreferences(d.preferences) &&
        d.updatedAt is timestamp &&
        existsAfter(usernamePath) &&
        existsAfter(publicPath) &&
        existsAfter(statsPath);
    }

    function validInitialProfileCompletion(uid) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();

      return resource.data.get('profileCompleted', false) != true &&
        d.get('profileCompleted', false) == true &&
        changed.hasOnly([
          'email', 'createdAt', 'displayName', 'displayNameNormalized',
          'username', 'usernameNormalized', 'avatarId', 'profileCompleted',
          'profileCompletedAt', 'onboardingCompleted', 'xp',
          'leaderboardScore', 'visitedPoiIds', 'unlockedAchievements',
          'pendingAchievements', 'maxQuizScore', 'totalQuizCompleted',
          'totalToursCompleted', 'totalCorrectAnswers', 'bestTourTimeSeconds',
          'maxSingleTourXp', 'friends', 'sentFriendRequests',
          'receivedFriendRequests', 'fcmTokens', 'preferences', 'updatedAt'
        ]) &&
        validInitialProfileData(uid, d);
    }

    function validInitialProfileCreate(uid) {
      let d = request.resource.data;

      return d.createdAt is timestamp &&
        d.keys().hasOnly([
          'email', 'createdAt', 'displayName', 'displayNameNormalized',
          'username', 'usernameNormalized', 'avatarId', 'profileCompleted',
          'profileCompletedAt', 'onboardingCompleted', 'xp',
          'leaderboardScore', 'visitedPoiIds', 'unlockedAchievements',
          'pendingAchievements', 'maxQuizScore', 'totalQuizCompleted',
          'totalToursCompleted', 'totalCorrectAnswers', 'bestTourTimeSeconds',
          'maxSingleTourXp', 'friends', 'sentFriendRequests',
          'receivedFriendRequests', 'fcmTokens', 'preferences', 'updatedAt'
        ]) &&
        validInitialProfileData(uid, d);
    }

    // ---------------------------------------------------------
    // USER PROGRESS
    // ---------------------------------------------------------

    function validOwnerProgressUpdate() {
      let old = resource.data;
      let next = request.resource.data;

      return next.diff(old).affectedKeys().hasOnly([
          'visitedPoiIds', 'xp', 'leaderboardScore', 'maxSingleTourXp',
          'maxQuizScore', 'totalQuizCompleted', 'totalToursCompleted',
          'totalCorrectAnswers', 'bestTourTimeSeconds', 'pendingAchievements',
          'updatedAt', 'lastProgressAt'
        ]) &&
        next.get('xp', 0) >= old.get('xp', 0) &&
        next.get('xp', 0) <= old.get('xp', 0) + 80 &&
        next.get('lastProgressAt', null) == request.time &&
        next.get('leaderboardScore', 0) == next.get('xp', 0) &&
        next.get('totalQuizCompleted', 0) >= old.get('totalQuizCompleted', 0) &&
        next.get('totalQuizCompleted', 0) <= old.get('totalQuizCompleted', 0) + 1 &&
        next.get('totalCorrectAnswers', 0) >= old.get('totalCorrectAnswers', 0) &&
        next.get('totalCorrectAnswers', 0) <= old.get('totalCorrectAnswers', 0) + 3 &&
        next.get('maxQuizScore', 0) >= old.get('maxQuizScore', 0) &&
        next.get('maxQuizScore', 0) <= 100 &&
        next.get('totalToursCompleted', 0) >= old.get('totalToursCompleted', 0) &&
        next.get('totalToursCompleted', 0) <= old.get('totalToursCompleted', 0) + 1 &&
        (
          next.get('totalToursCompleted', 0) ==
            old.get('totalToursCompleted', 0) ||
          next.get('visitedPoiIds', []).hasAll([
            'santa_cristina', 'rocca', 'san_rocco', 'abbazia_monte',
            'osservanza', 'palazzo_ridotto', 'stazione', 'arrigoni',
            'fantaguzzi', 'rifugi_antiaerei'
          ])
        ) &&
        next.get('maxSingleTourXp', 0) >= old.get('maxSingleTourXp', 0) &&
        next.get('maxSingleTourXp', 0) <= next.get('xp', 0) &&
        next.get('visitedPoiIds', []) is list &&
        next.get('visitedPoiIds', []).size() <=
          old.get('visitedPoiIds', []).size() + 1 &&
        validVisitedPoiIds(next.get('visitedPoiIds', [])) &&
        next.get('visitedPoiIds', []).hasAll(old.get('visitedPoiIds', [])) &&
        validAchievementIdsAdded(
          old,
          next,
          old.get('pendingAchievements', []),
          next.get('pendingAchievements', [])
        ) &&
        (
          next.get('totalToursCompleted', 0) >
            old.get('totalToursCompleted', 0)
          ? (
              next.get('bestTourTimeSeconds', 0) > 0 &&
              (
                old.get('bestTourTimeSeconds', 0) == 0 ||
                next.get('bestTourTimeSeconds', 0) <=
                  old.get('bestTourTimeSeconds', 0)
              )
            )
          : next.get('bestTourTimeSeconds', 0) ==
              old.get('bestTourTimeSeconds', 0)
        ) &&
        publicMirrorMatches(request.auth.uid) &&
        friendStatsMirrorMatches(request.auth.uid) &&
        leaderboardMirrorMatches(request.auth.uid);
    }

    function validAchievementClaim() {
      let old = resource.data;
      let next = request.resource.data;

      return next.diff(old).affectedKeys().hasOnly([
          'pendingAchievements', 'unlockedAchievements', 'updatedAt'
        ]) &&
        listRemovesOne(
          old.get('pendingAchievements', []),
          next.get('pendingAchievements', [])
        ) &&
        next.get('unlockedAchievements', []).size() <=
          old.get('unlockedAchievements', []).size() + 1 &&
        next.get('unlockedAchievements', []).hasAll(
          old.get('unlockedAchievements', [])
        ) &&
        next.get('unlockedAchievements', []).toSet()
          .difference(old.get('unlockedAchievements', []).toSet())
          .hasOnly(old.get('pendingAchievements', [])) &&
        validAchievementList(next.get('unlockedAchievements', [])) &&
        publicMirrorMatches(request.auth.uid) &&
        friendStatsMirrorMatches(request.auth.uid);
    }

    // ---------------------------------------------------------
    // PROFILE / SETTINGS
    // ---------------------------------------------------------

    function validProfileBasicsUpdate(uid) {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'displayName', 'displayNameNormalized', 'avatarId', 'updatedAt'
        ]) &&
        (
          !('displayName' in changed) ||
          (
            next.displayName is string &&
            next.displayName.size() >= 2 &&
            next.displayName.size() <= 30
          )
        ) &&
        (
          !('displayNameNormalized' in changed) ||
          (
            next.displayNameNormalized is string &&
            next.displayNameNormalized.size() <= 30 &&
            next.displayNameNormalized == next.displayName.lower()
          )
        ) &&
        (
          !('avatarId' in changed) ||
          (
            next.avatarId is string &&
            next.avatarId.size() > 0 &&
            next.avatarId.size() <= 40
          )
        ) &&
        next.displayNameNormalized == next.displayName.lower() &&
        publicMirrorMatches(uid);
    }

    function validPreferencesUpdate() {
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['preferences', 'updatedAt']) &&
        validPreferences(
          request.resource.data.get('preferences', {})
        );
    }

    function validOnboardingUpdate(uid) {
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['onboardingCompleted', 'updatedAt']) &&
        request.resource.data.get('onboardingCompleted', false) == true &&
        publicMirrorMatches(uid);
    }

    function validFcmTokenUpdate() {
      let oldTokens = resource.data.get('fcmTokens', []);
      let newTokens = request.resource.data.get('fcmTokens', []);

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['fcmTokens', 'updatedAt']) &&
        newTokens is list &&
        newTokens.size() <= 20 &&
        (
          listAddsOne(oldTokens, newTokens) ||
          listRemovesOne(oldTokens, newTokens)
        );
    }

    // ---------------------------------------------------------
    // FRIEND REQUESTS
    // ---------------------------------------------------------

    function validSentRequestAdd(uid) {
      let peer = request.resource.data.get('lastFriendActionPeerUid', '');

      let path =
        /databases/$(database)/documents/friend_requests/$(peer)/inbox/$(uid);

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'sentFriendRequests', 'lastFriendActionPeerUid', 'updatedAt'
          ]) &&
        peer is string &&
        peer.size() > 0 &&
        peer != uid &&
        !hasBlockBetween(uid, peer) &&
        !resource.data.get('friends', []).hasAny([peer]) &&
        !resource.data.get('receivedFriendRequests', []).hasAny([peer]) &&
        !exists(/databases/$(database)/documents/banned_users/$(peer)) &&
        !exists(
          /databases/$(database)/documents/friend_requests/$(uid)/inbox/$(peer)
        ) &&
        listAddsOnly(
          resource.data.get('sentFriendRequests', []),
          request.resource.data.get('sentFriendRequests', []),
          peer
        ) &&
        request.resource.data.get('sentFriendRequests', []).size() <= 100 &&
        existsAfter(path) &&
        getAfter(path).data.senderUid == uid &&
        getAfter(path).data.recipientUid == peer;
    }

    function validSentRequestRemoval(uid) {
      let peer = request.resource.data.get('lastFriendActionPeerUid', '');

      let path =
        /databases/$(database)/documents/friend_requests/$(peer)/inbox/$(uid);

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'sentFriendRequests', 'lastFriendActionPeerUid', 'updatedAt'
          ]) &&
        peer is string &&
        peer.size() > 0 &&
        listRemovesOnly(
          resource.data.get('sentFriendRequests', []),
          request.resource.data.get('sentFriendRequests', []),
          peer
        ) &&
        !existsAfter(path);
    }

    function validIncomingRequestAdd(uid) {
      let path =
        /databases/$(database)/documents/friend_requests/$(uid)/inbox/$(request.auth.uid);

      let callerAfter =
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;

      return !exists(/databases/$(database)/documents/banned_users/$(uid)) &&
        !hasBlockBetween(uid, request.auth.uid) &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'receivedFriendRequests', 'updatedAt'
          ]) &&
        listAddsOnly(
          resource.data.get('receivedFriendRequests', []),
          request.resource.data.get('receivedFriendRequests', []),
          request.auth.uid
        ) &&
        request.resource.data.get('receivedFriendRequests', []).size() <= 100 &&
        !resource.data.get('sentFriendRequests', []).hasAny([request.auth.uid]) &&
        !resource.data.get('friends', []).hasAny([request.auth.uid]) &&
        !callerAfter.get('friends', []).hasAny([uid]) &&
        existsAfter(path) &&
        callerAfter.get('sentFriendRequests', []).hasAny([uid]);
    }

    function validCrossSentRequestRemoval(uid) {
      let peer = request.resource.data.get('lastFriendActionPeerUid', '');

      let requestPath =
        /databases/$(database)/documents/friend_requests/$(request.auth.uid)/inbox/$(uid);

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'sentFriendRequests', 'lastFriendActionPeerUid', 'updatedAt'
          ]) &&
        peer == request.auth.uid &&
        !hasBlockBetween(uid, request.auth.uid) &&
        listRemovesOnly(
          resource.data.get('sentFriendRequests', []),
          request.resource.data.get('sentFriendRequests', []),
          request.auth.uid
        ) &&
        !existsAfter(requestPath) &&
        (
          !existsAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ) ||
          !getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.get('receivedFriendRequests', []).hasAny([uid])
        );
    }

    function validCrossReceivedRequestRemoval(uid) {
      let path =
        /databases/$(database)/documents/friend_requests/$(uid)/inbox/$(request.auth.uid);

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'receivedFriendRequests', 'lastFriendActionPeerUid', 'updatedAt'
          ]) &&
        request.resource.data.get('lastFriendActionPeerUid', '') ==
          request.auth.uid &&
        listRemovesOnly(
          resource.data.get('receivedFriendRequests', []),
          request.resource.data.get('receivedFriendRequests', []),
          request.auth.uid
        ) &&
        !existsAfter(path);
    }

    function validReceivedRequestRemoval(uid) {
      let peer = request.resource.data.get('lastFriendActionPeerUid', '');

      let path =
        /databases/$(database)/documents/friend_requests/$(uid)/inbox/$(peer);

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'receivedFriendRequests', 'lastFriendActionPeerUid', 'updatedAt'
          ]) &&
        peer is string &&
        peer.size() > 0 &&
        listRemovesOnly(
          resource.data.get('receivedFriendRequests', []),
          request.resource.data.get('receivedFriendRequests', []),
          peer
        ) &&
        !existsAfter(path);
    }

    // ---------------------------------------------------------
    // FRIEND ACCEPTANCE / REMOVAL
    // ---------------------------------------------------------

    function validAcceptingFriendUpdate(uid) {
      let peer = request.resource.data.get('lastFriendActionPeerUid', '');

      let requestPath =
        /databases/$(database)/documents/friend_requests/$(uid)/inbox/$(peer);

      let peerAfter =
        getAfter(/databases/$(database)/documents/users/$(peer)).data;

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'receivedFriendRequests', 'friends', 'pendingAchievements',
            'lastFriendActionPeerUid', 'updatedAt'
          ]) &&
        peer is string &&
        peer.size() > 0 &&
        peer != uid &&
        !hasBlockBetween(uid, peer) &&
        listRemovesOnly(
          resource.data.get('receivedFriendRequests', []),
          request.resource.data.get('receivedFriendRequests', []),
          peer
        ) &&
        listAddsOnly(
          resource.data.get('friends', []),
          request.resource.data.get('friends', []),
          peer
        ) &&
        exists(requestPath) &&
        !existsAfter(requestPath) &&
        !exists(/databases/$(database)/documents/banned_users/$(peer)) &&
        peerAfter.get('friends', []).hasAny([uid]) &&
        !peerAfter.get('sentFriendRequests', []).hasAny([uid]) &&
        friendAchievementChangeAllowed(
          resource.data.get('pendingAchievements', []),
          request.resource.data.get('pendingAchievements', [])
        ) &&
        publicMirrorMatches(uid) &&
        friendStatsMirrorMatches(uid);
    }

    function validAcceptedFriendUpdate(uid) {
      let peer = request.resource.data.get('lastFriendActionPeerUid', '');

      let requestPath =
        /databases/$(database)/documents/friend_requests/$(request.auth.uid)/inbox/$(uid);

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'sentFriendRequests', 'friends', 'pendingAchievements',
            'lastFriendActionPeerUid', 'updatedAt'
          ]) &&
        peer == request.auth.uid &&
        listRemovesOnly(
          resource.data.get('sentFriendRequests', []),
          request.resource.data.get('sentFriendRequests', []),
          request.auth.uid
        ) &&
        listAddsOnly(
          resource.data.get('friends', []),
          request.resource.data.get('friends', []),
          request.auth.uid
        ) &&
        exists(requestPath) &&
        !existsAfter(requestPath) &&
        !exists(/databases/$(database)/documents/banned_users/$(uid)) &&
        friendAchievementChangeAllowed(
          resource.data.get('pendingAchievements', []),
          request.resource.data.get('pendingAchievements', [])
        ) &&
        friendStatsMirrorMatches(uid);
    }

    function validOwnerFriendRemoval(uid) {
      let peer = request.resource.data.get('lastFriendActionPeerUid', '');

      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'friends', 'lastFriendActionPeerUid', 'updatedAt'
          ]) &&
        peer is string &&
        peer.size() > 0 &&
        peer != uid &&
        listRemovesOnly(
          resource.data.get('friends', []),
          request.resource.data.get('friends', []),
          peer
        ) &&
        !getAfter(
          /databases/$(database)/documents/users/$(peer)
        ).data.get('friends', []).hasAny([uid]) &&
        !getAfter(
          /databases/$(database)/documents/friend_stats/$(peer)
        ).data.get('friends', []).hasAny([uid]) &&
        publicMirrorMatches(uid) &&
        friendStatsMirrorMatches(uid);
    }

    function validCrossFriendRemoval(uid) {
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'friends', 'updatedAt', 'lastFriendActionPeerUid'
          ]) &&
        request.resource.data.get('lastFriendActionPeerUid', '') ==
          request.auth.uid &&
        listRemovesOnly(
          resource.data.get('friends', []),
          request.resource.data.get('friends', []),
          request.auth.uid
        ) &&
        request.resource.data.get('friends', []) ==
          getAfter(
            /databases/$(database)/documents/users/$(uid)
          ).data.get('friends', []) &&
        (
          !existsAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ) ||
          !getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.get('friends', []).hasAny([uid])
        ) &&
        friendStatsMirrorMatches(uid);
    }

    // ---------------------------------------------------------
    // OWNER UPDATE ROUTING
    // ---------------------------------------------------------

    function ownerUserUpdateAllowed(uid) {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();

      return (
        changed.hasAny(['usernameNormalized']) &&
        validInitialProfileCompletion(uid)
      ) || (
        !changed.hasAny(['usernameNormalized']) && (
          validProfileBasicsUpdate(uid) ||
          validPreferencesUpdate() ||
          validOnboardingUpdate(uid) ||
          validFcmTokenUpdate() ||
          validOwnerProgressUpdate() ||
          validOwnerFriendAchievementUpdate() ||
          validAchievementClaim() ||
          validSentRequestAdd(uid) ||
          validSentRequestRemoval(uid) ||
          validAcceptingFriendUpdate(uid) ||
          validOwnerFriendRemoval(uid)
        )
      );
    }

    function userAfterCanClaimUsername(usernameId) {
      let userAfter =
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;

      return userAfter.get('profileCompleted', false) == true &&
        userAfter.get('usernameNormalized', '') == usernameId;
    }

    // ---------------------------------------------------------
    // USERS
    // ---------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) && isNotBanned();

      allow list: if false;

      allow create: if isOwner(userId) &&
        isNotBanned() &&
        (
          (
            request.resource.data.keys()
              .hasOnly(['email', 'createdAt', 'updatedAt']) &&
            request.resource.data.email is string &&
            request.resource.data.email.size() <= 254 &&
            request.auth.token.email == request.resource.data.email &&
            request.resource.data.createdAt is timestamp &&
            request.resource.data.updatedAt is timestamp
          ) ||
          validInitialProfileCreate(userId)
        );

      allow update: if isNotBanned() && (
        (
          isOwner(userId) &&
          (
            ownerUserUpdateAllowed(userId) ||
            (
              !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['usernameNormalized']) &&
              validReceivedRequestRemoval(userId)
            )
          )
        ) ||
        (
          !isOwner(userId) &&
          (
            validIncomingRequestAdd(userId) ||
            validCrossSentRequestRemoval(userId) ||
            validCrossReceivedRequestRemoval(userId) ||
            validAcceptedFriendUpdate(userId) ||
            validCrossFriendRemoval(userId)
          )
        )
      );

      allow delete: if isOwner(userId) &&
        !existsAfter(
          /databases/$(database)/documents/public_profiles/$(userId)
        );
    }

    // ---------------------------------------------------------
    // PUBLIC PROFILES
    // ---------------------------------------------------------

    match /public_profiles/{userId} {
      allow get: if isSignedIn() &&
        isNotBanned() &&
        !exists(
          /databases/$(database)/documents/banned_users/$(userId)
        );

      allow list: if isSignedIn() &&
        isNotBanned() &&
        request.query.limit != null &&
        request.query.limit <= 50;

      allow create: if isOwner(userId) &&
        isNotBanned() &&
        validPublicProfileCreate(userId);

      allow update: if (
          isOwner(userId) &&
          isNotBanned() &&
          validPublicProfileShape(request.resource.data) &&
          publicMirrorMatches(userId)
        ) ||
        validCrossPublicProfileFriendsCountUpdate(userId);

      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // FRIEND STATS
    // ---------------------------------------------------------

    match /friend_stats/{userId} {
      allow get: if canReadFriendStats(userId);

      allow list: if false;

      allow create: if isOwner(userId) &&
        isNotBanned() &&
        validFriendStatsCreate(userId);

      allow update: if isNotBanned() && (
        (
          isOwner(userId) &&
          (
            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  'xp',
                  'visitedPoiIds',
                  'unlockedAchievements',
                  'maxQuizScore',
                  'totalQuizCompleted',
                  'totalToursCompleted',
                  'totalCorrectAnswers',
                  'bestTourTimeSeconds',
                  'maxSingleTourXp'
                ]) &&
              validFriendStatsShape(request.resource.data) &&
              friendStatsMirrorMatches(userId)
            ) ||
            validOwnerFriendStatsFriendsUpdate(userId)
          )
        ) ||
        (
          !isOwner(userId) &&
          validCrossFriendStatsUpdate(userId)
        )
      );

      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // LEADERBOARD
    // ---------------------------------------------------------

    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isNotBanned();

      allow list: if isSignedIn() &&
        isNotBanned() &&
        request.query.limit != null &&
        request.query.limit <= 50;

      allow create, update: if isOwner(userId) &&
        isNotBanned() &&
        validLeaderboardProjection(userId, request.resource.data);

      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // USERNAMES
    // ---------------------------------------------------------

    match /usernames/{usernameId} {
      allow get: if isSignedIn() &&
        (
          isNotBanned() ||
          resource.data.uid == request.auth.uid
        );

      allow list: if false;

      allow create: if isSignedIn() &&
        isNotBanned() &&
        isValidUsernameId(usernameId) &&
        !exists(
          /databases/$(database)/documents/usernames/$(usernameId)
        ) &&
        request.resource.data.keys()
          .hasOnly(['uid', 'username', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == usernameId &&
        request.resource.data.createdAt is timestamp &&
        userAfterCanClaimUsername(usernameId);

      allow update: if false;

      allow delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        (
          !existsAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ) ||
          getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.get('usernameNormalized', '') != usernameId
        );
    }

    // ---------------------------------------------------------
    // FRIEND REQUEST DOCUMENTS
    // ---------------------------------------------------------

    match /friend_requests/{recipientUid}/inbox/{senderUid} {
      allow get: if isSignedIn() &&
        isNotBanned() &&
        (
          request.auth.uid == recipientUid ||
          request.auth.uid == senderUid
        );

      allow list: if isOwner(recipientUid) && isNotBanned();

      allow create: if isOwner(senderUid) &&
        isNotBanned() &&
        recipientUid != senderUid &&
        !hasBlockBetween(recipientUid, senderUid) &&
        !exists(
          /databases/$(database)/documents/banned_users/$(recipientUid)
        ) &&
        exists(
          /databases/$(database)/documents/public_profiles/$(recipientUid)
        ) &&
        request.resource.data.keys()
          .hasOnly(['senderUid', 'recipientUid', 'createdAt']) &&
        request.resource.data.senderUid == senderUid &&
        request.resource.data.recipientUid == recipientUid &&
        request.resource.data.createdAt is timestamp &&
        !exists(
          /databases/$(database)/documents/friend_requests/$(recipientUid)/inbox/$(senderUid)
        ) &&
        existsAfter(
          /databases/$(database)/documents/users/$(senderUid)
        ) &&
        getAfter(
          /databases/$(database)/documents/users/$(senderUid)
        ).data.get('sentFriendRequests', []).hasAny([recipientUid]) &&
        existsAfter(
          /databases/$(database)/documents/users/$(recipientUid)
        ) &&
        getAfter(
          /databases/$(database)/documents/users/$(recipientUid)
        ).data.get('receivedFriendRequests', []).hasAny([senderUid]);

      allow update: if false;

      allow delete: if isSignedIn() &&
        (
          request.auth.uid == recipientUid ||
          request.auth.uid == senderUid
        ) &&
        (
          !existsAfter(
            /databases/$(database)/documents/users/$(senderUid)
          ) ||
          !getAfter(
            /databases/$(database)/documents/users/$(senderUid)
          ).data.get('sentFriendRequests', []).hasAny([recipientUid])
        ) &&
        (
          !existsAfter(
            /databases/$(database)/documents/users/$(recipientUid)
          ) ||
          !getAfter(
            /databases/$(database)/documents/users/$(recipientUid)
          ).data.get('receivedFriendRequests', []).hasAny([senderUid])
        );
    }

    // ---------------------------------------------------------
    // USER BLOCKS
    // ---------------------------------------------------------

    match /user_blocks/{blockerUid}/blocked/{blockedUid} {
      // Only the owner can inspect their own block list.
      allow get, list: if isOwner(blockerUid) && isNotBanned();

      allow create: if isOwner(blockerUid) &&
        isNotBanned() &&
        blockerUid != blockedUid &&
        !exists(
          /databases/$(database)/documents/banned_users/$(blockedUid)
        ) &&
        exists(
          /databases/$(database)/documents/public_profiles/$(blockedUid)
        ) &&
        request.resource.data.keys().hasOnly(['createdAt']) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.createdAt == request.time;

      // Allow account deletion to remove its own outgoing block records,
      // including when the account is under suspension.
      allow delete: if isOwner(blockerUid);
      allow update: if false;
    }

    // ---------------------------------------------------------
    // USER REPORTS
    // ---------------------------------------------------------

    match /user_reports/{reportId} {
      // Reports contain private moderation data and are not readable by clients.
      allow get, list: if false;

      allow create: if isSignedIn() &&
        isNotBanned() &&
        request.resource.data.keys().hasOnly([
          'reporterUid', 'reportedUid', 'reportedField', 'reportedValue',
          'reportedDisplayName', 'reportedUsername', 'reason', 'details',
          'createdAt', 'status'
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reportedUid is string &&
        request.resource.data.reportedUid != request.auth.uid &&
        request.resource.data.reportedField in ['displayName', 'username'] &&
        request.resource.data.reason in [
          'inappropriate_name', 'impersonation', 'harassment', 'spam', 'other'
        ] &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 500 &&
        request.resource.data.reportedDisplayName is string &&
        request.resource.data.reportedDisplayName.size() >= 2 &&
        request.resource.data.reportedDisplayName.size() <= 30 &&
        request.resource.data.reportedUsername is string &&
        request.resource.data.reportedUsername.size() >= 3 &&
        request.resource.data.reportedUsername.size() <= 20 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.status == 'pending' &&
        !exists(
          /databases/$(database)/documents/banned_users/$(request.resource.data.reportedUid)
        ) &&
        exists(
          /databases/$(database)/documents/public_profiles/$(request.resource.data.reportedUid)
        ) &&
        get(
          /databases/$(database)/documents/public_profiles/$(request.resource.data.reportedUid)
        ).data.displayName == request.resource.data.reportedDisplayName &&
        get(
          /databases/$(database)/documents/public_profiles/$(request.resource.data.reportedUid)
        ).data.username == request.resource.data.reportedUsername &&
        (
          (
            request.resource.data.reportedField == 'displayName' &&
            request.resource.data.reportedValue ==
              request.resource.data.reportedDisplayName
          ) ||
          (
            request.resource.data.reportedField == 'username' &&
            request.resource.data.reportedValue ==
              request.resource.data.reportedUsername
          )
        );

      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // BANNED USERS
    // ---------------------------------------------------------

    match /banned_users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
